# Local secrets — never commit
/config.local.php

# Composer: vendor/ IS tracked for shared hosting (no Composer on server).
# Run `composer install --no-dev` locally, then commit vendor/ before deploy.

# Uploads (runtime-generated; keep directory structure)
/uploads/properties/*
!/uploads/properties/.gitkeep
/uploads/branding/*
!/uploads/branding/.gitkeep
!/uploads/branding/.htaccess

# OS / IDE
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Logs / rate limits (runtime-generated)
*.log
/storage/logs/*
!/storage/logs/.gitkeep
/storage/rate_limits/*
!/storage/rate_limits/.gitkeep
