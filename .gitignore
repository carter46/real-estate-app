# Local secrets — never commit
/config.local.php

# Composer dependencies — installed by the host on deploy (composer install)
/vendor/

# Uploads (runtime-generated; keep directory structure)
/uploads/properties/*
!/uploads/properties/.gitkeep
/uploads/branding/*
!/uploads/branding/.gitkeep
!/uploads/branding/.htaccess

# OS / IDE
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Logs / rate limits
/storage/logs/*
!/storage/logs/.gitkeep
/storage/rate_limits/*
!/storage/rate_limits/.gitkeep
